{
  "$defs": {
    "availabilityGit": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/gitObject"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "availabilityIdentity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
