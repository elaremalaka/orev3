        "failed",
        "not_evaluated",
        "not_applicable"
      ],
      "type": "string"
    },
    "gitObject": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "nonReadyDisposition": {
      "enum": [
        "READINESS_UNRESOLVED_REMOTE",
        "READINESS_AMBIGUOUS",
        "READINESS_INVALID_RECORD",
        "READINESS_ORPHANED",
        "SUPERSEDED",
        "READINESS_STALE",
        "READINESS_INPUT_MISMATCH",
        "READINESS_BLOCKED_INPUT_UNAVAILABLE"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "orev3://schemas/execution-readiness/v1/readiness-failure-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_class": {
            "const": "READINESS_REJECTED"
          }
        },
        "required": [
          "receipt_class"
        ]
      },
      "then": {
        "properties": {
          "current_readiness_disposition": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_class": {
            "const": "CURRENT_READINESS"
          }
        },
        "required": [
          "receipt_class"
        ]
      },
      "then": {
        "properties": {
          "current_readiness_disposition": {
            "$ref": "#/$defs/nonReadyDisposition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_class": {
            "const": "LAUNCH_REJECTED"
          }
        },
        "required": [
          "receipt_class"
        ]
      },
      "then": {
        "properties": {
          "current_readiness_disposition": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonReadyDisposition"
              },
              {
                "const": "EXECUTION_READY",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  ],
  "properties": {
