{
    "$id": "orev3://schemas/execution-readiness/v1/outcome-blind-projection-evidence",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "allowed_fields": {
            "items": {
                "minLength": 1,
                "type": "string"
            },
            "maxItems": 4096,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true,
            "x-canonical-order": [
                "value"
            ]
        },
        "byte_count": {
            "minimum": 0,
            "type": "integer"
        },
        "dataset_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "ordered_record_count": {
            "minimum": 0,
            "type": "integer"
        },
        "projection_evidence_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "projection_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "projection_schema_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "parser_component_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "projector_component_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "raw_input_snapshot_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "schema_version": {
            "const": 1,
            "type": "integer"
        },
        "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        }
    },
    "required": [
        "allowed_fields",
        "byte_count",
        "dataset_identity",
        "ordered_record_count",
        "projection_evidence_identity",
        "projection_identity",
        "projection_schema_identity",
        "parser_component_identity",
        "projector_component_identity",
        "raw_input_snapshot_identity",
        "schema_version",
        "sha256"
    ],
    "title": "OutcomeBlindProjectionEvidenceV1",
    "type": "object"
}
