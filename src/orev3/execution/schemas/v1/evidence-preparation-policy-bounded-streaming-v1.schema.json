{
  "$id": "orev3://schemas/execution-readiness/v1/evidence-preparation-policy-bounded-streaming-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bounded_launch_authority": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_identifier": {"const": "bounded-streaming-worker-bootstrap-v1"},
        "bootstrap_path": {"const": "src/orev3/execution/bounded_streaming_worker_bootstrap.py"},
        "bootstrap_request_identity_domain": {"const": "orev3:bounded-streaming-worker-bootstrap-request:v1\n"},
        "bootstrap_request_max_bytes": {"const": 4194304},
        "cwd_policy": {"const": "cwd-ignored-absolute-fd-authority-v1"},
        "measurement_wrapper_identifier": {"const": "darwin-time-measurement-wrapper-v1"},
        "measurement_wrapper_identity": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "spawn_mechanism": {"const": "darwin-os-posix-spawn-file-actions-v1"}
      },
      "required": ["bootstrap_identifier", "bootstrap_path", "bootstrap_request_identity_domain", "bootstrap_request_max_bytes", "cwd_policy", "measurement_wrapper_identifier", "measurement_wrapper_identity", "spawn_mechanism"],
      "type": "object"
    },
    "limits": {
      "oneOf": [
        {"$ref": "#/$defs/measurementLimits"},
        {"$ref": "#/$defs/adoptedLimits"}
      ]
    },
    "policy_identifier": {"const": "experiment-evidence-preparation-policy-bounded-streaming-v1"},
    "policy_identity": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "policy_revision": {"const": "1"},
    "profile_renderer_identity": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": 1},
    "worker_profiles": {"items": {"$ref": "#/$defs/workerProfile"}, "maxItems": 4, "minItems": 4, "type": "array", "uniqueItems": true, "x-canonical-order": ["worker_kind"]}
  },
  "required": ["bounded_launch_authority", "limits", "policy_identifier", "policy_identity", "policy_revision", "profile_renderer_identity", "schema_version", "worker_profiles"],
  "title": "EvidencePreparationPolicyBoundedStreamingV1",
  "type": "object",
  "$defs": {
    "pending": {"additionalProperties": false, "properties": {"status": {"const": "measurement_pending"}}, "required": ["status"], "type": "object"},
    "positiveInteger": {"minimum": 1, "type": "integer"},
    "measurementLimits": {
      "additionalProperties": false,
      "properties": {
        "deferred_numeric_fields": {"const": ["max_controller_peak_rss_bytes", "max_projection_bytes", "max_temporary_disk_bytes", "max_worker_peak_rss_bytes", "watchdog_poll_interval_milliseconds", "watchdog_rss_bytes"]},
        "max_aggregate_collection_bytes": {"const": 1749809411},
        "max_collection_members": {"const": 256},
        "max_controller_peak_rss_bytes": {"$ref": "#/$defs/pending"},
        "max_file_bytes": {"const": 227867665},
        "max_open_files": {"$ref": "#/$defs/positiveInteger"},
        "max_processes": {"$ref": "#/$defs/positiveInteger"},
        "max_projection_bytes": {"const": 328739211471540},
        "max_replay_units": {"$ref": "#/$defs/positiveInteger"},
        "max_source_records": {"const": 1442676},
        "max_stderr_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_stdout_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_subprocess_seconds": {"$ref": "#/$defs/positiveInteger"},
        "max_temporary_disk_bytes": {"const": 657480406911612},
        "max_worker_peak_rss_bytes": {"$ref": "#/$defs/pending"},
        "numeric_envelope_mode": {"const": "BOUNDED_STREAMING_MEASUREMENT_CANDIDATE"},
        "watchdog_poll_interval_milliseconds": {"$ref": "#/$defs/pending"},
        "watchdog_rss_bytes": {"$ref": "#/$defs/pending"}
      },
      "required": ["deferred_numeric_fields", "max_aggregate_collection_bytes", "max_collection_members", "max_controller_peak_rss_bytes", "max_file_bytes", "max_open_files", "max_processes", "max_projection_bytes", "max_replay_units", "max_source_records", "max_stderr_bytes", "max_stdout_bytes", "max_subprocess_seconds", "max_temporary_disk_bytes", "max_worker_peak_rss_bytes", "numeric_envelope_mode", "watchdog_poll_interval_milliseconds", "watchdog_rss_bytes"],
      "type": "object"
    },
    "adoptedLimits": {
      "additionalProperties": false,
      "properties": {
        "max_aggregate_collection_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_collection_members": {"$ref": "#/$defs/positiveInteger"},
        "max_controller_peak_rss_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_file_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_open_files": {"$ref": "#/$defs/positiveInteger"},
        "max_processes": {"$ref": "#/$defs/positiveInteger"},
        "max_projection_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_replay_units": {"$ref": "#/$defs/positiveInteger"},
        "max_source_records": {"$ref": "#/$defs/positiveInteger"},
        "max_stderr_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_stdout_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_subprocess_seconds": {"$ref": "#/$defs/positiveInteger"},
        "max_temporary_disk_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_worker_peak_rss_bytes": {"$ref": "#/$defs/positiveInteger"},
        "numeric_envelope_mode": {"const": "BOUNDED_STREAMING_NUMERIC_ENVELOPE_ADOPTED"},
        "watchdog_poll_interval_milliseconds": {"$ref": "#/$defs/positiveInteger"},
        "watchdog_rss_bytes": {"$ref": "#/$defs/positiveInteger"}
      },
      "required": ["max_aggregate_collection_bytes", "max_collection_members", "max_controller_peak_rss_bytes", "max_file_bytes", "max_open_files", "max_processes", "max_projection_bytes", "max_replay_units", "max_source_records", "max_stderr_bytes", "max_stdout_bytes", "max_subprocess_seconds", "max_temporary_disk_bytes", "max_worker_peak_rss_bytes", "numeric_envelope_mode", "watchdog_poll_interval_milliseconds", "watchdog_rss_bytes"],
      "type": "object"
    },
    "stringSet": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true, "x-canonical-order": ["value"]},
    "workerProfile": {
      "additionalProperties": false,
      "properties": {
        "allowed_read_roles": {"$ref": "#/$defs/stringSet"},
        "allowed_write_roles": {"$ref": "#/$defs/stringSet"},
        "commands": {"$ref": "#/$defs/stringSet"},
        "denied_roles": {"$ref": "#/$defs/stringSet"},
        "module": {"pattern": "^src/orev3/execution/[a-z0-9_]+\\.py$", "type": "string"},
        "network_policy": {"const": "prohibited"},
        "sandbox_template_identity": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "sandbox_template_revision": {"enum": ["macos-seatbelt-capability-v4", "phase3a-network-sandbox-v1"]},
        "worker_kind": {"enum": ["INPUT_PROJECTOR", "PHASE3A_VALIDATOR", "READINESS_TEST", "REPLAY_PREPARATION"]}
      },
      "required": ["allowed_read_roles", "allowed_write_roles", "commands", "denied_roles", "module", "network_policy", "sandbox_template_identity", "sandbox_template_revision", "worker_kind"],
      "type": "object"
    }
  }
}
